---
import "~/styles/trust-badges.css";
---

<section class="trust-badges-wrap" aria-label="OneInfra Quality & Guarantees">
  <div class="container">
    <div class="trust-badges-grid">
      <div class="trust-badge-card">
        <div class="trust-badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v18M3 9l9-6 9 6M3 9l9 6 9-6M3 9v6l9 6 9-6V9" />
          </svg>
        </div>
        <div class="trust-badge-content">
          <h3>Weighbridge Slip</h3>
          <p>100% Computerized weigh slip with gross, tare &amp; net weight. Zero volume short-loading disputes.</p>
        </div>
      </div>

      <div class="trust-badge-card">
        <div class="trust-badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
        </div>
        <div class="trust-badge-content">
          <h3>IS 383:2016 Certified</h3>
          <p>Zone II/III structural grading for RCC slabs, beams, and columns. Batch test sheets provided.</p>
        </div>
      </div>

      <div class="trust-badge-card">
        <div class="trust-badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
          </svg>
        </div>
        <div class="trust-badge-content">
          <h3>Double-Washed (&lt;3% Silt)</h3>
          <p>Hydro-cyclone washed granite fines. Perform the glass jar silt test on site before unloading.</p>
        </div>
      </div>

      <div class="trust-badge-card">
        <div class="trust-badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13" />
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
            <circle cx="5.5" cy="18.5" r="2.5" />
            <circle cx="18.5" cy="18.5" r="2.5" />
          </svg>
        </div>
        <div class="trust-badge-content">
          <h3>Quarry Direct Supply</h3>
          <p>Tambaram supply yard, 6 &amp; 10-wheel tippers on the road by 7 AM. Zero broker commission markup.</p>
        </div>
      </div>
    </div>
  </div>
</section>
