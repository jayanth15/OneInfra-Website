---
import type { ProductPrice } from "~/config/site";
import { site } from "~/config/site";
import "~/styles/price.css";

interface Props { product: ProductPrice; }
const { product } = Astro.props;
const unitToTon = Math.round((product.pricePerUnit / product.pricePerTon) * 10) / 10;
---

<div class="price-card" id={product.slug}>
  <span class="label">{product.unitSize}</span>
  <h3>{product.name}</h3>
  <span class="num">₹{product.pricePerTon}<span class="unit"> /ton</span></span>
  <span class="per">or ₹{product.pricePerUnit} per unit (≈{unitToTon} ton)</span>
  <a class="btn btn-primary" href={`tel:${site.phoneTel}`}>Call for quote</a>
</div>
