---
import type { ProductPrice } from "~/config/site";
import { site } from "~/config/site";

interface Props { product: ProductPrice; index?: number; }
const { product, index } = Astro.props;
const num = (typeof index === "number") ? String(index + 1).padStart(2, "0") : null;
// Friendly short name: take the first word before any space, dash, or parenthesis
const shortName = product.name.split(/[\s(-]/)[0];
const perUnit = Math.round((product.pricePerUnit / product.pricePerTon) * 10) / 10;
---

<div class="price-card" id={product.slug}>
  <span class="label">{num ? `${num} · ${shortName}` : product.unitSize}</span>
  <h3>{product.name}</h3>
  <div class="num">₹ {product.pricePerTon.toLocaleString("en-IN")}<span class="unit">/ ton</span></div>
  <p class="per">Per unit (100 CFT ≈ 1.4 ton): ₹ {product.pricePerUnit.toLocaleString("en-IN")} (~{perUnit} ton)</p>
  <div class="row"><span class="k">Grade</span><span class="v">IS 383 · washed</span></div>
  <div class="row"><span class="k">Pack</span><span class="v">Loose tipper</span></div>
  <div class="row"><span class="k">Min order</span><span class="v">1 tipper (300 CFT)</span></div>
  <a class="btn btn-primary" href={`tel:${site.phoneTel}`}>Call for today's {shortName} quote</a>
</div>
