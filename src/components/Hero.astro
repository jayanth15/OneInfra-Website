---
import { site } from "~/config/site";
import "~/styles/hero.css";

interface Props {
  eyebrow: string;
  titleHtml: string;
  body: string;
  bgImage?: string;
  bgAlt?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  trustStrip?: { n: string; l: string }[];
}
const {
  eyebrow, titleHtml, body, bgImage, bgAlt = "",
  primaryCta, secondaryCta, trustStrip,
} = Astro.props;
const defaultCta = { href: `tel:${site.phoneTel}`, label: `Call ${site.phone}` };
const pCta = primaryCta ?? defaultCta;
---

<section class="hero">
  {bgImage && (
    <div class="hero-bg">
      <img src={bgImage} alt={bgAlt} loading="eager" fetchpriority="high" />
    </div>
  )}
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={titleHtml}></h1>
    <p>{body}</p>
    <div class="hero-cta">
      <a class="btn btn-primary btn-large" href={pCta.href}>{pCta.label}</a>
      {secondaryCta && (
        <a class="btn btn-secondary btn-large" href={secondaryCta.href}>{secondaryCta.label}</a>
      )}
    </div>
    {trustStrip && (
      <div class="trust-strip">
        {trustStrip.map((t) => (
          <div class="trust">
            <span class="n">{t.n}</span>
            <span class="l">{t.l}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
