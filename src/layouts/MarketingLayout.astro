---
import BaseLayout from "./BaseLayout.astro";
interface Props {
  title: string;
  description: string;
  current: "home" | "products" | "price" | "calculator" | "about" | "contact" | "guide" | "area" | "blog";
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
}
const { title, description, current, canonical, ogImage, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} current={current} canonical={canonical} ogImage={ogImage} jsonLd={jsonLd}>
  <slot />
</BaseLayout>
