---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import Hero from "~/components/Hero.astro";
import CtaStrip from "~/components/CtaStrip.astro";
import TrustBadges from "~/components/TrustBadges.astro";
import MaterialGuideTable from "~/components/MaterialGuideTable.astro";
import ProjectShowcase from "~/components/ProjectShowcase.astro";
import { site, prices, productOrder } from "~/config/site";
import { websiteLd } from "~/lib/schema";
import "~/styles/cards.css";
import "~/styles/home-pricing.css";
import "~/styles/home-stats.css";
import "~/styles/home-learn.css";

const title = `OneInfra · Trusted Supplier of M-Sand, P-Sand and Aggregate in Chennai`;
const description = `OneInfra is a trusted supplier of double-washed M-Sand, P-Sand and blue-metal aggregates in Chennai. Same-day tipper supply to Tambaram, Velachery, Porur, Medavakkam, OMR, ECR, Guduvanchery, Ambattur and Anna Nagar. Call ${site.phone}.`;
const jsonLd = [websiteLd()];

const heroProducts = [
  prices.products.m_sand_double_washed,
  prices.products.p_sand,
  prices.products.aggregate_20mm_jelly,
];
const shortName = (name: string) => {
  if (name.startsWith("M-Sand")) return "Msand";
  if (name.startsWith("P-Sand")) return "Psand";
  return name.split(/[\s(-]/)[0];
};
---

<MarketingLayout title={title} description={description} current="home" jsonLd={jsonLd}>
  <Hero
    eyebrow="Chennai · Direct Quarry Material Supply"
    titleHtml={`A trusted supplier of M-Sand, P-Sand and <span class="accent">Aggregate in Chennai.</span>`}
    body="OneInfra supplies double-washed M-Sand, P-Sand and certified blue-metal aggregates to homeowners, masons and builders across Chennai. Real photos, computerized weighbridge slips, an interactive quantity calculator, and plain-English field guides."
    bgImage="/images-opt/product-msand-double-washed.webp"
    bgAlt="Washed M-Sand on a hand-held pile, dark grey granite fines"
    secondaryCta={{ href: "/products", label: "See all 9 products" }}
    trustStrip={[
      { n: "9 grades", l: "M-Sand · P-Sand · Dust · 12/20/25/40mm · WMM" },
      { n: "Same day", l: "delivery across Chennai" },
      { n: "IS 383", l: "graded &amp; double-washed" },
      { n: "Tambaram yard", l: "14 Chennai areas served daily" },
    ]}
  />

  <TrustBadges />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Explore OneInfra</p>
      <h2 style="max-width: 24ch; margin-bottom: var(--space-3);">Everything you need for structural and finishing masonry.</h2>
      <p style="color:var(--muted);font-size:17px;max-width:56ch;margin-bottom:var(--space-8);">
        Select a section below or call us directly for an instant quote.
      </p>
      <div class="pages-grid">
        <a class="page-card" href="/products">
          <div class="thumb"><img src="/images-opt/product-msand-double-washed.webp" alt="Handful of dark grey double-washed M-Sand" loading="lazy" width="800" height="450" /></div>
          <div class="body">
            <span class="label">Catalogue</span>
            <h3>Products &amp; grades</h3>
            <p>All 9 grades with real photos: M-Sand, P-Sand, dust, 12/20/25/40mm, WMM. Sizes, uses, IS 383 spec.</p>
            <span class="arrow">See products →</span>
          </div>
        </a>
        <a class="page-card" href="/price">
          <div class="thumb"><img src="/images-opt/hero-three-piles.webp" alt="Three conical piles of different construction materials" loading="lazy" width="800" height="450" /></div>
          <div class="body">
            <span class="label">Pricing</span>
            <h3>This week's price in Chennai</h3>
            <p>Per-ton and per-unit rates for tipper loads. Six factors that change the price across the year.</p>
            <span class="arrow">See price →</span>
          </div>
        </a>
        <a class="page-card" href="/calculator">
          <div class="thumb"><img src="/images-opt/Home-Example.webp" alt="OneInfra supply yard with M-Sand, P-Sand and 20mm aggregate stockpiled" loading="lazy" width="800" height="450" /></div>
          <div class="body">
            <span class="label">Estimator</span>
            <h3>Quantity calculator</h3>
            <p>Type your built-up area and number of floors. Get tonnage, CFT, tipper count and a live price estimate.</p>
            <span class="arrow">Open calculator →</span>
          </div>
        </a>
        <a class="page-card" href="/areas/tambaram">
          <div class="thumb"><img src="/images-opt/delivery-truck.webp" alt="Tipper truck delivering aggregates" loading="lazy" width="800" height="450" /></div>
          <div class="body">
            <span class="label">Local delivery</span>
            <h3>14 Chennai areas</h3>
            <p>Same-day routes to Tambaram, Velachery, Porur, Medavakkam, OMR, ECR, Guduvanchery, Ambattur, and Anna Nagar.</p>
            <span class="arrow">Check your area →</span>
          </div>
        </a>
        <a class="page-card" href="/about">
          <div class="thumb"><img src="/images-opt/About-Page.webp" alt="20mm blue metal aggregate" loading="lazy" width="800" height="450" /></div>
          <div class="body">
            <span class="label">Company</span>
            <h3>About OneInfra</h3>
            <p>Our story, our quality promise, computerized weighbridge operations, and our dedicated delivery fleet.</p>
            <span class="arrow">About us →</span>
          </div>
        </a>
        <a class="page-card" href="/contact">
          <div class="thumb"><img src="/images-opt/site-construction.webp" alt="Chennai construction site at golden hour" loading="lazy" width="800" height="450" /></div>
          <div class="body">
            <span class="label">Get in touch</span>
            <h3>Contact &amp; Yard Visit</h3>
            <p>Call, WhatsApp, or visit the Tambaram supply point. We answer in under a minute during work hours.</p>
            <span class="arrow">Contact us →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-pricing">
    <div class="container">
      <p class="eyebrow">This week's price · Chennai</p>
      <h2 style="max-width: 28ch;">Transparent per-ton and per-unit rates for tipper loads.</h2>
      <p class="lead">Prices shift with fuel, demand and quarry rates. The numbers below are this week's band — call for the exact rate on the day of delivery.</p>
      <div class="home-price-grid">
        {heroProducts.map((p, idx) => (
          <div class="home-price-card">
            <span class="label">{String(idx + 1).padStart(2, "0")} · {shortName(p.name)}</span>
            <h3>{p.name}</h3>
            <div class="num">₹ {p.pricePerTon.toLocaleString("en-IN")}<span class="unit">/ ton</span></div>
            <p class="per">Per unit (100 CFT ≈ 4.5 ton): ₹ {p.pricePerUnit.toLocaleString("en-IN")} (~{p.unitToTon} ton)</p>
            <a class="btn btn-primary" href={`tel:${site.phoneTel}`}>Call for today's {shortName(p.name)} quote</a>
          </div>
        ))}
      </div>
      <div class="home-price-disclaimer">
        <div class="icon">i</div>
        <p><strong>Prices exclude transport.</strong> Transport is charged per trip based on your area — Tambaram, Velachery, Porur, Medavakkam, OMR, ECR, Guduvanchery, Ambattur, Avadi, Anna Nagar, and surrounding suburbs. We quote both numbers on the call before the tipper is loaded.</p>
      </div>
    </div>
  </section>

  <MaterialGuideTable />

  <section class="section home-stats">
    <div class="container">
      <div class="home-stats-strip">
        <div class="stat"><div class="num">14<span class="accent">+</span></div><div class="lbl">Chennai areas served daily</div></div>
        <div class="stat"><div class="num">IS<span class="accent">383</span></div><div class="lbl">Graded M-Sand &amp; aggregates</div></div>
        <div class="stat"><div class="num"><span class="accent">100%</span></div><div class="lbl">Weighbridge slip guaranteed</div></div>
        <div class="stat"><div class="num">1<span class="accent"> call</span></div><div class="lbl">Phone-first, no forms, no apps</div></div>
      </div>
    </div>
  </section>

  <ProjectShowcase />

  <section class="section home-learn">
    <div class="container">
      <p class="eyebrow">Builder Knowledge Base</p>
      <h2 style="max-width: 28ch;">Field guides for Chennai home-builders &amp; contractors.</h2>
      <p class="lead">Plain-English, practical guides written for homeowners, engineers, and masons.</p>
      <div class="home-learn-grid">
        <a class="home-learn-card" href="/guides/concrete-mix-ratio-chennai">
          <span class="label">Field guide · 7 min read</span>
          <h3>Concrete mix ratios (M20, M25, M15)</h3>
          <p>Cement, M-Sand, and 20mm blue metal calculations per 100 sq ft roof slab, with hot-weather curing tips in Chennai.</p>
        </a>
        <a class="home-learn-card" href="/guides/tipper-lorry-capacity-guide">
          <span class="label">Measurement · 6 min read</span>
          <h3>Tipper lorry capacity in Chennai</h3>
          <p>Units, CFT, and tonnage for 2-unit 6-wheelers and 4-unit 10-wheelers. How to measure lorry boxes and verify weigh slips.</p>
        </a>
        <a class="home-learn-card" href="/guides/msand-vs-river-sand">
          <span class="label">Guide · 6 min read</span>
          <h3>M-Sand vs river sand</h3>
          <p>Strength, grading, silt, cost and the environment — why M-Sand is the default for Chennai construction in 2026.</p>
        </a>
        <a class="home-learn-card" href="/guides/quality-check">
          <span class="label">Field guide · 5 min read</span>
          <h3>How to check M-Sand quality on site</h3>
          <p>Five field tests to run when the tipper arrives, before the load is tipped. Silt, palm, particle shape, gradation and certificate.</p>
        </a>
        <a class="home-learn-card" href="/guides/cft-lorry-guide">
          <span class="label">Measurement · 6 min read</span>
          <h3>What is CFT and how to measure a lorry</h3>
          <p>CFT, m³, tons and units — conversion table, lorry-size chart, and a worked example with a 6-wheel tipper.</p>
        </a>
        <a class="home-learn-card" href="/price">
          <span class="label">Pricing · updated weekly</span>
          <h3>This week's price band in Chennai</h3>
          <p>Per-ton and per-unit rates for tipper loads. Six factors that move the price across the year — and how to lock a quote.</p>
        </a>
      </div>
    </div>
  </section>

  <CtaStrip
    title="One call for price, quantity and delivery."
    body="Tell us what you are building, where, and how much. We will quote a per-ton, per-unit and transport number — and book a delivery slot on the same call."
    small="Open Mon–Sat · 7 am to 8 pm · Sun by appointment"
  />
</MarketingLayout>
