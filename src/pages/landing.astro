---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import Hero from "~/components/Hero.astro";
import CtaStrip from "~/components/CtaStrip.astro";
import { site, prices, productOrder } from "~/config/site";
import { localBusinessLd, productListLd } from "~/lib/schema";
import "~/styles/cards.css";

const title = `OneInfra · M-Sand, P-Sand and Aggregate Supplier in Chennai`;
const description = `OneInfra is a trusted supplier of clean M-Sand, P-Sand and Aggregate to homeowners, contractors and builders across Chennai. Call ${site.phone} for a same-day quote.`;
const jsonLd = [localBusinessLd(), productListLd()];

const audienceCards = [
  { title: "Homeowners", body: "Building a house in Chennai? We'll tell you exactly which grade, what quantity, and a fair price — in plain English." },
  { title: "Masons & contractors", body: "Daily route, same-day tipper loading, no fake promises. WhatsApp your BOQ, get a quote in 5 minutes." },
  { title: "Civil engineers", body: "IS 383 graded, washed, with mill test reports on request. Quantities match your BOQ, no short loading." },
];

const steps = [
  { n: 1, t: "Call or WhatsApp", b: "Tell us the grade, quantity, and delivery area. Under 1 minute." },
  { n: 2, t: "Firm quote",       b: "We lock the rate for your order, in writing if you want it." },
  { n: 3, t: "Tipper loaded",    b: "Tambaram yard, washed and weighed. Mill sheet on request." },
  { n: 4, t: "Delivered",        b: "Same-day in 6 areas. ETA confirmed on dispatch." },
];
---

<MarketingLayout title={title} description={description} current="home" jsonLd={jsonLd}>
  <Hero
    eyebrow="Chennai · Trusted supplier"
    titleHtml={`One call gets you <span class="accent">clean M-Sand, P-Sand and blue-metal</span> at a fair Chennai price.`}
    body="Nine grades, real product photos, IS 383 graded and washed before loading. Same-day delivery to Tambaram, Velachery, OMR, ECR, Ambattur, Avadi and Anna Nagar."
    bgImage="/images-opt/Home-Example.jpg"
    bgAlt="OneInfra supply yard in Tambaram with three grades of aggregate in conical piles"
    secondaryCta={{ href: "/products", label: "See all 9 grades" }}
    trustStrip={[
      { n: "9 grades", l: "M-Sand · P-Sand · Dust · 12/20/20-blue/25/40mm · WMM" },
      { n: "Same day", l: "delivery on most orders" },
      { n: "IS 383", l: "graded &amp; washed before loading" },
      { n: "Tambaram supply", l: "7 Chennai areas served daily" },
    ]}
  />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Catalogue</p>
      <h2 style="max-width:24ch;margin-bottom:var(--space-3);">All 9 grades, one page</h2>
      <p style="color:var(--muted);font-size:17px;max-width:60ch;margin-bottom:var(--space-8);">
        Real photos. Real IS 383 grading. Real Chennai prices.
      </p>
      <div class="product-grid">
        {productOrder.map((k) => {
          const p = prices.products[k];
          return (
            <a class="page-card" href={`/products#${p.slug}`}>
              <div class="thumb">
                <img src={p.image} alt={p.name} loading="lazy" width="800" height="600" />
              </div>
              <div class="body">
                <span class="label">{p.unitSize}</span>
                <h3>{p.name}</h3>
                <p>{p.description}</p>
                <span class="arrow">From ₹{p.pricePerTon}/ton →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Who we serve</p>
      <h2 style="max-width:24ch;margin-bottom:var(--space-8);">Three audiences, one promise</h2>
      <div class="pages-grid">
        {audienceCards.map((c) => (
          <div class="page-card" style="cursor:default;">
            <div class="body" style="padding: var(--space-6);">
              <h3 style="font-size:20px;">{c.title}</h3>
              <p style="font-size:15px;color:var(--muted);">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Process</p>
      <h2 style="max-width:24ch;margin-bottom:var(--space-3);">Four steps from call to delivered</h2>
      <p style="color:var(--muted);font-size:17px;max-width:60ch;margin-bottom:var(--space-8);">
        Plain, no surprises.
      </p>
      <ol style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-5);list-style:none;padding:0;counter-reset:step;">
        {steps.map((s) => (
          <li style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:var(--space-6);position:relative;">
            <span style="font-family:var(--font-mono);font-size:13px;color:var(--accent);">Step {s.n}</span>
            <h3 style="font-size:18px;margin-top:var(--space-2);">{s.t}</h3>
            <p style="font-size:14px;color:var(--muted);margin-top:var(--space-2);">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Areas served daily</p>
      <h2 style="margin-bottom: var(--space-3);">7 Chennai areas, daily route</h2>
      <p style="color:var(--muted);font-size:17px;max-width:60ch;margin-bottom:var(--space-6);">
        Tipper on the road every working day, Tambaram supply point.
      </p>
      <div class="pages-grid">
        {site.serviceAreas.map((a) => (
          <a class="page-card" href={`/areas/${a.toLowerCase().replace(/[\s.]/g, "-")}`}>
            <div class="body" style="padding: var(--space-6);">
              <h3 style="font-size:18px;">M-Sand, P-Sand &amp; aggregate in {a}</h3>
              <p style="font-size:14px;color:var(--muted);">Same-day delivery · IS 383 graded</p>
              <span class="arrow">Open {a} page →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    title="One call. One firm quote. Same-day delivery."
    body="We price by phone in under a minute. No forms, no waiting."
    secondaryCta={{ href: "/calculator", label: "Try the calculator" }}
  />
</MarketingLayout>
