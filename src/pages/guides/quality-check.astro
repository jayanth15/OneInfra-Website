---
import GuideLayout from "~/layouts/GuideLayout.astro";
import CtaStrip from "~/components/CtaStrip.astro";
import { site } from "~/config/site";
import { localBusinessLd, faqLd, breadcrumbLd } from "~/lib/schema";

const title = `5 Field Tests for M-Sand Quality · Chennai Builder Guide`;
const description = `Five field tests to check M-Sand quality the moment the tipper arrives. Silt test, palm test, particle shape, gradation, and the IS 383 sieve check. For Chennai homeowners, masons and small builders.`;
const jsonLd = [
  localBusinessLd(),
  breadcrumbLd([
    { name: "Home", url: site.url + "/" },
    { name: "Guides", url: site.url + "/guides/cft-lorry-guide" },
    { name: "Quality Check", url: site.url + "/guides/quality-check" },
  ]),
  faqLd([
    { q: "How do I check M-Sand quality on site?", a: "Do the silt test (sand + water in a bottle), palm test (rub sand between palms), particle shape (cubical, not flaky), gradation (mix with cement should not bleed), and ask for the IS 383 mill sheet." },
    { q: "What silt % is acceptable in M-Sand?", a: "IS 383 allows up to 3% silt for plastering sand and 5% for concrete sand. Above that, the sand will weaken the mix and increase water demand." },
  ]),
];
---

<GuideLayout title={title} description={description} eyebrow="Field guide" body="Five field tests to run the moment the tipper arrives — before the sand is unloaded. Two minutes, no equipment." bgImage="/images/quality-check.jpg" bgAlt="A handful of M-Sand ready for field testing" jsonLd={jsonLd}>
  <h2>The five tests</h2>
  <ol>
    <li><strong>Silt test</strong> — half a bottle of sand, top with water, shake, let settle. Silt layer should be under 3 mm.</li>
    <li><strong>Palm test</strong> — rub dry sand between palms. Sharp, gritty = good. Smooth, floury = too many fines.</li>
    <li><strong>Particle shape</strong> — particles should be cubical, not flaky. Flaky particles weaken the mix.</li>
    <li><strong>Gradation</strong> — mix sand with cement on a board. It should hold shape and not bleed water.</li>
    <li><strong>Mill sheet</strong> — ask for the IS 383 sieve analysis. We provide this on request for every batch.</li>
  </ol>
</GuideLayout>
