import CtaStrip from "~/components/CtaStrip.astro";
import { site } from "~/config/site";
import { localBusinessLd, faqLd, breadcrumbLd } from "~/lib/schema";

const title = `M-Sand vs River Sand · Chennai Builder's Complete Comparison`;
const description = `Why M-Sand is the better choice for Chennai construction in 2026 — and when river sand still has a use. Strength, grading, silt, cost, environment and quality checks compared.`;
const jsonLd = [
  localBusinessLd(),
  breadcrumbLd([
    { name: "Home", url: site.url + "/" },
    { name: "Guides", url: site.url + "/guides/cft-lorry-guide" },
    { name: "M-Sand vs River Sand", url: site.url + "/guides/msand-vs-river-sand" },
  ]),
  faqLd([
    { q: "Is M-Sand as strong as river sand?", a: "Yes. Washed, IS 383 graded M-Sand performs as well as or better than river sand in RCC and plaster, with more consistent grading and lower silt." },
    { q: "Why is M-Sand cheaper than river sand in Chennai?", a: "M-Sand is manufactured locally from granite, no river mining required, lower transport cost, and more consistent supply. It usually prices 10-20% below river sand." },
    { q: "Does M-Sand contain silt?", a: "Washed M-Sand has under 3% silt, well within IS 383 limits. Unwashed crusher dust can run 8-15% silt and is not suitable for plaster or fine concrete work." },
    { q: "Is M-Sand allowed for structural concrete?", a: "Yes. IS 383 graded M-Sand (Zone II/III) is explicitly permitted for RCC up to M30 grade when washed and graded. OneInfra provides mill test reports on request." },
  ]),
];
---

<GuideLayout title={title} description={description} eyebrow="Guide · M-Sand vs River Sand" body="Why M-Sand is the better choice for most Chennai construction in 2026 — and the few cases where river sand still has a place." bgImage="/images-opt/msand.webp" bgAlt="Handful of dark grey double-washed M-Sand" jsonLd={jsonLd}>

  <h2 id="what">What is M-Sand, and what is river sand?</h2>
  <p><strong>M-Sand</strong> (Manufactured Sand) is crushed granite rock, ground to sand-sized particles (under 4.75 mm), then washed and graded. <strong>River sand</strong> is natural sand dredged or mined from river beds — the traditional choice in India for thousands of years. In Chennai, both are widely available, but the Tamil Nadu government has progressively restricted river sand mining since 2013 to protect river ecosystems, and M-Sand has filled the gap.</p>
  <p>Today, over 80% of new Chennai construction uses M-Sand for structural and plaster work, with river sand now a specialty or imported product.</p>

  <h2 id="why">Eight reasons M-Sand wins for most Chennai builds</h2>
  <ol>
    <li><strong>Consistent grading.</strong> M-Sand is graded to IS 383 Zone II/III in a controlled plant. River sand grading varies by source, season, and how deep the dredger was digging.</li>
    <li><strong>Lower silt content.</strong> Washed M-Sand has under 3% silt. Unwashed river sand can run 6-10% silt — silt weakens concrete by increasing water demand and reducing bond strength.</li>
    <li><strong>Better shape.</strong> M-Sand particles are angular and cubical, which gives better interlock and bond with cement paste. River sand is rounded (because of water tumbling), giving slightly less mechanical bond.</li>
    <li><strong>Plaster-friendly.</strong> M-Sand is graded to the fine zone masons want for smooth wall finishes. River sand is often a mix of fine and coarse that requires sieving on site.</li>
    <li><strong>No clay or organic matter.</strong> River sand occasionally contains clay lumps or organic debris that have to be washed out. M-Sand is clean by default.</li>
    <li><strong>10-20% cheaper.</strong> M-Sand is locally manufactured, no river-mining royalty, shorter transport. Price per ton is consistently below river sand.</li>
    <li><strong>No environmental damage.</strong> River sand mining causes bank erosion, lowers water tables, and damages aquatic habitats. M-Sand is a quarry by-product of aggregate production — material that was being made anyway.</li>
    <li><strong>Consistent supply.</strong> No monsoon shutdowns, no government quota cuts. Order any working day of the year.</li>
  </ol>

  <h2 id="when">When you might still want river sand</h2>
  <p>River sand still has niche uses in 2026 Chennai construction:</p>
  <ul>
    <li><strong>Heritage and restoration work</strong> where matching original materials matters.</li>
    <li><strong>Tile bedding and jointing</strong> — masons sometimes prefer river sand's rounded grain for traditional tile-laying techniques.</li>
    <li><strong>Some specialty finishes</strong> like exposed-aggregate walls where the rounded river-sand look is desired.</li>
  </ul>
  <p>For all other applications — foundation, RCC, brickwork, plaster, flooring screed — washed M-Sand graded to IS 383 is the better choice. The OneInfra team will always tell you when river sand is the right call; otherwise we default to M-Sand.</p>

